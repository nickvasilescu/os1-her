# ---------------------------------------------------------------------------
# OS1 / Samantha — copy to .env (never commit .env)
# ---------------------------------------------------------------------------
APP_URL=http://localhost:8000

# --- Hermes (runs on Samantha's Orgo VM, reached through a tunnel) ---
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=                       # same value as API_SERVER_KEY in the Hermes profile .env
HERMES_VOICE_MODEL=samantha-voice     # model_routes alias (fast model, reasoning off)
HERMES_WORK_MODEL=samantha-work       # model_routes alias (Claude Opus 5.5)
OS1_SESSION_KEY=agent:samantha:voice:primary

# --- Model providers (used by Hermes) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Fish Audio (Drama 3) ---
FISH_API_KEY=
FISH_OPERATOR_VOICE_ID=               # onboarding operator
FISH_VOICE_1_ID=                      # Voice I (female, warm) — default
FISH_VOICE_2_ID=                      # Voice II (bright)
FISH_VOICE_MALE_ID=                   # optional: chosen when the user asks for a male voice

# --- LiveKit (realtime audio) ---
LIVEKIT_URL=                         # self-hosted dev: ws://127.0.0.1:7880 (scripts/run-uaos1.command starts it)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Jev (TypeSafe System One) ---
TYPESAFE_API_KEY=
JEV_TRANSPORT=live                    # live | off
JEV_MODEL=jev-1.14.0

# --- Orchestrator ---
ORCHESTRATOR_URL=http://127.0.0.1:8787
ORCHESTRATOR_PUBLIC_URL=               # Public HTTPS URL for port 8787
OS1_CLIENT_TOKEN=                     # desktop app + worker -> orchestrator bearer token (required)
OS1_INITIATION_S=6
OS1_ENABLE_DEV_RESET=0                # set to 1 only when replaying onboarding in dev
OS1_MAX_PAYMENT_USD=25.00             # hard per-call USD cap for payment tools
# OS1_ALLOWED_RECIPIENTS=             # optional comma-separated allowlist for outbound email/messages

# --- Orgo (Samantha's own cloud computer) ---
ORGO_API_KEY=
ORGO_COMPUTER_ID=                     # your Orgo computer ID

# --- Composio (slice 4) ---
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
# COMPOSIO_ORG_API_KEY=
# COMPOSIO_SPOTIFY_AUTH_CONFIG_ID=
# COMPOSIO_TWILIO_AUTH_CONFIG_ID=
# COMPOSIO_EXA_AUTH_CONFIG_ID=

# --- Voice engine / brain ---
OS1_VOICE_ENGINE=drama3               # drama3 (our worker, exact Drama 3) | live3 (Fish Live 3 full duplex)
OS1_FAST_MODEL=claude-sonnet-5-5        # the brain: one fast call per spoken turn
OS1_BRAIN_TOKEN=                      # Fish -> brain server bearer
BRAIN_PUBLIC_URL=
FISH_AGENT_ID=

# --- UAO bridge: Apps & services + Atlas (orchestrator → server, tailnet/LAN only) ---
UAO_API_BASE=https://server.tail85e19.ts.net:8444            # UAO backend (Homarr app catalogue)
ATLAS_API_BASE=https://server.tail85e19.ts.net:8459/atlas/api # Atlas agents API
UAO_TAILNET_SUFFIXES=tail85e19.ts.net                        # hosts allowed upstream and inside in-app views
UAO_TOKEN=                                                   # optional bearer for the UAO backend
ATLAS_TOKEN=                                                 # optional bearer for Atlas
OS1_UAO_PREFETCH=1                                           # keep the app list warm so "open jellyfin" works by voice

# --- UAOS1 voice ---
OS1_VOICE_PROVIDERS=free                                     # free = UAO Jarvis transcribe/TTS/chat; fish = original Fish + Anthropic
UAOS1_TTS_VOICE=                                             # optional voice override for /api/jarvis/tts
UAOS1_ACK_AFTER_S=2.5                                        # speak "On it" when the brain is slower than this
UAOS1_BRAIN_TIMEOUT_S=180

# --- UAOS1 shared server (docs/uao-bridge.md › "One server") -----------------------------
# On the Mac / laptop: point the desktop app at the home server's orchestrator instead of running one here.
# UAOS1_SERVER_URL=https://server.tail85e19.ts.net:8796
# UAOS1_SERVER_TOKEN=            # the server's OS1_CLIENT_TOKEN
# On the server:
# LIVEKIT_PUBLIC_URL=wss://server.tail85e19.ts.net:7444   # what apps on other devices connect to
# UAOS1_FAST_LLM_URL=http://127.0.0.1:20128               # OpenAI-compatible router for quick replies
# UAOS1_FAST_LLM_MODEL=auto/best-chat
# UAOS1_NTFY_URL=http://127.0.0.1:2586                    # self-hosted ntfy for phone notifications
# UAOS1_NTFY_TOPIC=                                       # long random topic name
# UAOS1_MEMORY_SYNC=1                                     # mirror Samantha's memories into Atlas
